# Klucz API Google Cloud (Credentials → Create Credentials → API key).
# Ogranicz go w konsoli do "Google Drive API", bez OAuth/service accounta.
# Działa, bo folder na Dysku jest udostępniony publicznie ("Każdy z linkiem").
GOOGLE_API_KEY=

# ID folderu głównego na Dysku Google (z URL: drive.google.com/drive/folders/<ID>).
DRIVE_ROOT_FOLDER_ID=14Ym90hHiqlLEz6ln8Jjdtb3yQB-EO5Sx

# Ustaw na "1", żeby dodatkowo liczyć % nawierzchni przez dopasowanie do OSM (BRouter).
# Wolniejsze i zależne od publicznego serwera brouter.de — domyślnie wyłączone.
ENABLE_SURFACE_ANALYSIS=0
